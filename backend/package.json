{
  "name": "flowra-backend",
  "version": "1.0.0",
  "description": "Backend API for Flowra - AI-powered project management platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
