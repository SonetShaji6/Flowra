# ---------------------------------------------------------------------------
# Flowra — repository ignore rules
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Environment files — NEVER commit real secrets.
# Only .env.example files (placeholders) are tracked.
.env
.env.*
!.env.example
!**/.env.example

# Build output
dist/
build/
out/
.vite/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/
*.lcov

# Caches
.cache/
.eslintcache
.parcel-cache/
.npm/

# Uploads (local dev only — production uploads go to cloud storage)
backend/uploads/
uploads/
tmp/

# Editors / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Secrets / credentials — defensive patterns
*.pem
*.key
*.p12
*.pfx
secrets.json
serviceAccount*.json
credentials.json

# Evidence: allow docs and images, block anything credential-shaped
evidence/**/*.env
evidence/**/secret*
evidence/**/credential*
